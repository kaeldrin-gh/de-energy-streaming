# de-energy-streaming — environment template
# Copy to `.env` only if you want to override defaults; docker-compose.yml already
# ships safe local defaults for everything below.

# ---------- Warehouse / object storage (LocalStack S3 emulator) ----------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
S3_ENDPOINT=http://localstack:4566
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg
ICEBERG_WAREHOUSE=s3a://energy-lake/warehouse
CHECKPOINT_BASE=s3a://energy-lake/checkpoints

# ---------- Kafka (Redpanda, Kafka-compatible) ----------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_PRICES=energy.prices.raw
KAFKA_TOPIC_DLQ=energy.prices.invalid

# ---------- Market data source (SMARD.de, no key required) ----------
SMARD_FILTER=4169        # day-ahead price Deutschland/Luxemburg
SMARD_REGION=DE-LU
SMARD_BASE_URL=https://www.smard.de/app/chart_data

# ---------- Postgres (Airflow metadata + Iceberg catalog + serving) ----------
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
SERVING_DSN=postgresql://energy:energy@postgres:5432/serving

# ---------- Running pieces on the host instead of Docker ----------
# Uncomment when running `python -m producer ...` directly on your machine:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# S3_ENDPOINT=http://localhost:4566
