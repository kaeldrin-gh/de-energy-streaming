# Build context slimming: everything the images need is copied explicitly.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.idea
.vscode

# Not needed inside images
docs
tests
airflow/logs
terraform/.terraform
terraform/*.tfstate*
.env
.env.*
!.env.example
docker-compose.yml
Makefile

# Repo metadata
*.md
!README.md
LICENSE
.gitignore
